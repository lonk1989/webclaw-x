+            error_code: Some("AMBIGUOUS_TARGET".into()), run_dir: None,
+        };
+        let row = serde_json::to_value(event).unwrap();
+        assert_eq!(row["type"], "done");
+        assert_eq!(row["error_code"], "AMBIGUOUS_TARGET");
+    }
