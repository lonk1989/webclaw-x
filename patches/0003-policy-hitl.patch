+"""Bounded live CLI run lifecycle: return NEED_HUMAN without killing the child.
+
+No shell, no automatic human acknowledgement. One active browser job per gateway.
+"""
+from __future__ import annotations
+import json
+import queue
+import re
+import subprocess
+import threading
+import time
+import uuid
+from pathlib import Path
+
+_jobs: dict[str, 'LiveRun'] = {}
+_guard = threading.RLock()
+
+class LiveRun:
+    def __init__(self, command, env, stdin_text, timeout, dualwrite):
+        self.id = uuid.uuid4().hex
+        self.home = Path(env['WEBCLAW_HOME']).resolve()
+        self.deadline = time.monotonic() + timeout
+        self.dualwrite = dualwrite
+        self.events = queue.Queue()
+        self.stdout = ''
+        self.stderr = ''
+        self.waiting = None
+        self.run_dir = None
+        self.collect_lock = threading.Lock()
+        self.proc = subprocess.Popen(command, env=env, text=True, stdin=subprocess.PIPE,
+                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=1)
+        threading.Thread(target=self._stdout, daemon=True).start()
+        threading.Thread(target=self._stderr, daemon=True).start()
+        threading.Thread(target=self._watchdog, daemon=True).start()
+        if stdin_text is not None:
+            self.proc.stdin.write(stdin_text)
+        self.proc.stdin.close()
+
+    def _stdout(self):
+        try:
+            for line in self.proc.stdout:
+                self.stdout = (self.stdout + line)[-200_000:]
+                m = re.search(r'run_dir=(\S+)', line)
+                if m:
+                    self.run_dir = m.group(1)
+                try:
+                    row = json.loads(line)
+                except ValueError:
+                    continue
+                if row.get('type') in ('need_human', 'done'):
+                    self.events.put(row)
+        finally:
+            self.events.put({'type': '_eof'})
+
+    def _stderr(self):
+        for line in self.proc.stderr:
+            self.stderr = (self.stderr + line)[-50_000:]
+
+    def _watchdog(self):
+        try:
+            self.proc.wait(timeout=max(0.01, self.deadline - time.monotonic()))
+        except subprocess.TimeoutExpired:
+            self.proc.kill()
+            self.proc.wait()
+
+    def collect(self):
+        with self.collect_lock:
+            while True:
+                try:
+                    event = self.events.get(timeout=max(0.01, self.deadline - time.monotonic()))
+                except queue.Empty:
+                    self.proc.kill()
+                    self.proc.wait()
+                    event = {'type': '_timeout'}
+                kind = event['type']
+                if kind == 'need_human':
+                    self.waiting = event
+                    return self.result(False, 'NEED_HUMAN', 'Human action required; reply to this run_id')
+                if kind in ('done', '_eof', '_timeout'):
+                    self.proc.wait(timeout=10)
+                    self.waiting = None
+                    with _guard:
+                        _jobs.pop(self.id, None)
+                    timed_out = kind == '_timeout' or time.monotonic() >= self.deadline
+                    ok = self.proc.returncode == 0 and not timed_out
+                    return self.result(ok, 'TIMEOUT' if timed_out else ('OK' if ok else 'RUN_FAILED'))
+
+    def result(self, ok, code, message=''):
+        return {'ok': ok, 'code': code, 'message': message,
+                'job_id': self.id, 'run_dir': self.run_dir, 'waiting': self.waiting,
+                'data': {'stdout': self.stdout, 'stderr': self.stderr, 'exit_code': self.proc.poll()}}
+
+
+def start(command, env, stdin_text, timeout, dualwrite=True):
+    with _guard:
+        if any(j.proc.poll() is None for j in _jobs.values()):
+            return {'ok': False, 'code': 'RUN_BUSY', 'message': 'A run is active; reply or cancel first', 'data': {}}
+        job = LiveRun(command, env, stdin_text, timeout, dualwrite)
+        _jobs[job.id] = job
+    return job.collect()
+
+
+def waiting(run_id='', prompt_id='', *, claim=False):
+    with _guard:
+        candidates = [j for j in _jobs.values()
+                      if j.waiting and j.proc.poll() is None and (not run_id or j.id == run_id)]
+        if len(candidates) != 1:
+            return None
+        job = candidates[0]
+        if prompt_id and prompt_id != job.waiting.get('prompt_id'):
+            return None
+        # Refuse stale/archived inboxes and arbitrary caller paths.
+        if not job.run_dir:
+            return None
+        rd = Path(job.run_dir).resolve()
+        if not rd.is_relative_to(job.home / 'runs'):
+            return None
+        if not (rd / 'human' / 'waiting_human.json').is_file():
+            return None
+        if claim:
+            job.waiting = None
+        return job
