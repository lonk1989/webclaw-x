+#!/usr/bin/env python3
+"""Recipe version/env integration eval -> eval/out/recipe-library.json."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+from datetime import datetime
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT/'eval/out'
+
+def main():
+    OUT.mkdir(parents=True,exist_ok=True)
+    stamp = datetime.now().strftime('%Y%m%d-%H%M%S')
+    env = os.environ.copy(); env['PYTHONPATH'] = str(ROOT)
+    p = subprocess.run([str(ROOT/'.venv/bin/python'), '-m','pytest','tests/test_recipe_library.py','-v','--tb=short'],
+                       cwd=ROOT, env=env, text=True,capture_output=True,timeout=240)
+    log = (p.stdout or '')+'\n'+(p.stderr or '')
+    (OUT/f'recipe-library-{stamp}.txt').write_text(log)
+    result = {'stamp':stamp,'timezone':'Asia/Shanghai','status':'green' if p.returncode==0 else 'red',
+              'exit_code':p.returncode,'tests':[l.strip() for l in log.splitlines() if '::test_' in l]}
+    (OUT/'recipe-library.json').write_text(json.dumps(result,ensure_ascii=False,indent=2))
+    print(json.dumps(result,ensure_ascii=False,indent=2))
+    print(f'REPORT={OUT/"recipe-library.json"}')
+    return p.returncode
+
+if __name__=='__main__': sys.exit(main())
