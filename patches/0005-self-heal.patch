+        let _ = c.sync_page_meta().await;
+        crate::navigation_policy::check_navigation(&c.target_url)?;
+        crate::self_heal::trace(step_index, "refresh", 1, &config);
+        c.reload(false).await.map_err(|_| "NEED_REPAIR: refresh failed".to_string())?;
+        result = execute_step_once(app, state, task_id, control, client.as_deref_mut(),
+            step, session, step_index, cancel, focus_ctx).await;
+        if result.is_ok() { return result; }
