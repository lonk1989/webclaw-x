+    let key = format!("{} {}", step.keyword, step.args.trim());
+    if step.keyword == "等待" {
+        if let Some(anchor) = config.structural_anchors.get(&key) {
+            crate::self_heal::trace(step_index, "structural_fallback", 1, &config);
+            let mut fallback = step.clone();
+            fallback.args = if anchor.split_whitespace().count() == 1 {
+                format!("{} 1", anchor) // Bounded default; structural wait parser needs >= 1s.
+            } else { anchor.clone() };
+            result = execute_step_once(app, state, task_id, control, client.as_deref_mut(),
+                &fallback, session, step_index, cancel, focus_ctx).await;
+            if result.is_ok() { return result; }
+            if crate::self_heal::terminal_error(result.as_ref().err().unwrap()) { return result; }
+        }
+    }
+    crate::self_heal::trace(step_index, "need_repair", 0, &config);
+    // Stage 4: real FileHumanBridge; an acknowledgement alone is not step success.
+    if config.hitl {
+        crate::self_heal::trace(step_index, "hitl", 1, &config);
+        let human = Step::new("人机验证", format!("{} 自愈需要人工修复当前页面；完成后确认，再验证原步骤", config.hitl_timeout_secs));
+        execute_step_once(app, state, task_id, control, client.as_deref_mut(),
+            &human, session, step_index, cancel, focus_ctx).await?;
+        result = execute_step_once(app, state, task_id, control, client.as_deref_mut(),
+            step, session, step_index, cancel, focus_ctx).await;
+        if result.is_ok() { return result; }
+        if crate::self_heal::terminal_error(result.as_ref().err().unwrap()) { return result; }
+    }
+    // Stage 5: bounded future proposal interface only. Never calls a model.
+    crate::self_heal::trace(step_index, "ai_hook_unimplemented", 0, &config);
+    Err("NEED_REPAIR: deterministic ladder exhausted; no automatic AI patch was applied".into())
+}
