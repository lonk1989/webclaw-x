+        result = execute_step_once(app, state, task_id, control, client.as_deref_mut(),
+            step, session, step_index, cancel, focus_ctx).await;
+        if result.is_ok() { return result; }
+        if crate::self_heal::terminal_error(result.as_ref().err().unwrap()) { return result; }
+    }
+    // Stage 2: refresh is explicitly opt-in (refresh may otherwise resubmit forms).
+    if config.refresh {
